<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_background">
    <LinearLayout android:id="@+id/widget_header" android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal" android:gravity="center_vertical" android:contentDescription="Open Casha loans">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:src="@mipmap/ic_launcher" android:importantForAccessibility="no"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Casha" android:textSize="19sp" android:textStyle="bold" android:textColor="#FFFFFF"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="end" android:text="CASH &amp; ENOUGH" android:textSize="9sp" android:textColor="#D8C492"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/widget_cash" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/widget_action" android:text="＋ Log cash" android:textStyle="bold" android:textColor="#FFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/widget_expense" android:layout_marginStart="8dp" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/widget_expense" android:text="− Expense" android:contentDescription="Add expense" android:textStyle="bold" android:textColor="#142A35" android:textSize="14sp"/>
    </LinearLayout>
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Your everyday money shortcuts" android:textColor="#D2E1E6" android:textSize="12sp" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/widget_due" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:minHeight="42dp" android:text="Open Casha to see your next due" android:textColor="#FFFFFF" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_payday" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="View Payday →" android:textColor="#78D6B5" android:textSize="12sp"/>
        <TextView android:id="@+id/widget_refresh" android:layout_width="72dp" android:layout_height="match_parent" android:gravity="center" android:text="Refresh ↻" android:textColor="#D8C492" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>